# Set two different passwords before starting. Never commit the real .env file.
LUKAS_PASSWORD=
OLI_PASSWORD=

# Local defaults. Set the public HTTPS origin and COOKIE_SECURE=true behind HTTPS.
APP_ORIGIN=http://localhost:8085
COOKIE_SECURE=false

# Bind to your server's LAN IP when a reverse proxy runs on another machine.
BIND_ADDRESS=127.0.0.1
PORT=8085

# Replace with ghcr.io/<owner>/<repository>:sha-<full-commit> for a published image.
SOULKEEPER_IMAGE=soulkeeper:local
